 // A_DAY_TO_KEEP_UI_73
 Mascot homeCharacter;
 boolean dueTasksComplete(){int total=0;for(int i=0;i<tasks.length();i++){JSONObject task=tasks.optJSONObject(i);if(task!=null&&taskDue(task,LocalDate.now())){total++;if(!task.optBoolean("done"))return false;}}return total>0;}
 void celebrateChecklistCompletion(){if(screen.equals("home")&&homeCharacter!=null&&homeCharacter.isAttachedToWindow()){startCharacterParty(homeCharacter);releaseCharacterParty();}}
 void semanticButtons(AlertDialog dialog){for(int which:new int[]{DialogInterface.BUTTON_POSITIVE,DialogInterface.BUTTON_NEGATIVE,DialogInterface.BUTTON_NEUTRAL}){Button b=dialog.getButton(which);if(b==null)continue;String title=b.getText().toString().toLowerCase(Locale.UK);boolean red=title.contains("cancel")||title.contains("remove")||title.contains("delete")||title.contains("discard")||title.contains("clear")||title.contains("restore")||title.contains("later")||title.equals("no");boolean green=title.contains("keep")||title.contains("add")||title.contains("done")||title.contains("save")||title.equals("yes")||title.equals("ok")||title.contains("proceed");int color=green?0xFFD8EBD6:red?0xFFF4D2D3:which==DialogInterface.BUTTON_NEGATIVE?0xFFF4D2D3:0xFFD8EBD6;b.setBackground(shape(color));b.setTextColor(INK);}}
 void themedScrolls(View view){boolean vertical=view instanceof ScrollView||(view instanceof EditText&&view.isVerticalScrollBarEnabled());if(vertical){view.setVerticalScrollBarEnabled(true);view.setVerticalScrollbarPosition(View.SCROLLBAR_POSITION_RIGHT);view.setScrollBarStyle(View.SCROLLBARS_OUTSIDE_INSET);view.setScrollBarSize(dp(3));view.setScrollbarFadingEnabled(true);view.setScrollBarDefaultDelayBeforeFade(350);view.setScrollBarFadeDuration(250);GradientDrawable thumb=new GradientDrawable();thumb.setColor(blend(LILAC,INK,.30f));thumb.setCornerRadius(dp(3));view.setVerticalScrollbarThumbDrawable(thumb);view.setVerticalScrollbarTrackDrawable(new android.graphics.drawable.ColorDrawable(Color.TRANSPARENT));if(view.getTag(uk.co.littledays.R.id.polish_scroll_tag)==null){view.setPadding(view.getPaddingLeft(),view.getPaddingTop(),view.getPaddingRight()+dp(7),view.getPaddingBottom());view.setTag(uk.co.littledays.R.id.polish_scroll_tag,Boolean.TRUE);}}if(view instanceof HorizontalScrollView&&view.isHorizontalScrollBarEnabled()){GradientDrawable thumb=new GradientDrawable();thumb.setColor(blend(LILAC,INK,.30f));thumb.setCornerRadius(dp(3));view.setHorizontalScrollbarThumbDrawable(thumb);view.setHorizontalScrollbarTrackDrawable(new android.graphics.drawable.ColorDrawable(Color.TRANSPARENT));view.setScrollBarSize(dp(3));view.setScrollbarFadingEnabled(true);view.setScrollBarDefaultDelayBeforeFade(350);}if(view instanceof ViewGroup){ViewGroup group=(ViewGroup)view;for(int i=0;i<group.getChildCount();i++)themedScrolls(group.getChildAt(i));}}
 int portraitCircleColor(ThemeSpec t){JSONObject entry=artMeta().optJSONObject("themes").optJSONObject(t.name);return entry==null?t.pink:entry.optInt("circleBackground",t.pink);}
