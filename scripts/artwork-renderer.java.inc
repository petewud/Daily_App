 final android.util.LruCache<String,Bitmap> artCache=new android.util.LruCache<String,Bitmap>(12*1024*1024){protected int sizeOf(String key,Bitmap value){return value.getByteCount();}};
 JSONObject artMetadata;
 JSONObject artMeta(){if(artMetadata==null){try(InputStream input=getAssets().open("artwork/theme-map.json")){java.io.ByteArrayOutputStream bytes=new java.io.ByteArrayOutputStream();byte[] buffer=new byte[8192];int count;while((count=input.read(buffer))!=-1)bytes.write(buffer,0,count);artMetadata=new JSONObject(bytes.toString("UTF-8"));}catch(Exception e){throw new IllegalStateException("Artwork manifest unavailable",e);}}return artMetadata;}
 Bitmap artBitmap(String file){Bitmap image=artCache.get(file);if(image==null){try(InputStream input=getAssets().open("artwork/"+file)){BitmapFactory.Options opts=new BitmapFactory.Options();opts.inScaled=false;image=BitmapFactory.decodeStream(input,null,opts);if(image==null)throw new IllegalStateException("Invalid artwork: "+file);artCache.put(file,image);}catch(Exception e){throw new IllegalStateException("Artwork unavailable: "+file,e);}}return image;}
 void drawArtProp(Canvas canvas,String name,float x,float y,float size,int alpha){JSONObject r=artMeta().optJSONObject("props").optJSONObject(name);if(r==null)throw new IllegalStateException("Unknown prop: "+name);int w=r.optInt("width"),h=r.optInt("height");float scale=size/Math.max(w,h),dw=w*scale,dh=h*scale;Paint pen=new Paint(Paint.ANTI_ALIAS_FLAG|Paint.FILTER_BITMAP_FLAG);pen.setAlpha(Math.max(0,Math.min(255,alpha)));canvas.drawBitmap(artBitmap("props_atlas.png"),new Rect(r.optInt("x"),r.optInt("y"),r.optInt("x")+w,r.optInt("y")+h),new RectF(x+(size-dw)/2,y+(size-dh)/2,x+(size+dw)/2,y+(size+dh)/2),pen);}
 class Mascot extends AnimatedArt {
  final ThemeSpec spec;boolean faceOnly=false;final Paint pen=new Paint(Paint.ANTI_ALIAS_FLAG|Paint.FILTER_BITMAP_FLAG);
  Mascot(ThemeSpec value){super();spec=value;setContentDescription(value.name+" character");}
  protected void onDraw(Canvas c){super.onDraw(c);JSONObject info=artMeta().optJSONObject("themes").optJSONObject(spec.name);if(info==null)throw new IllegalStateException("Unknown portrait: "+spec.name);Bitmap image=artBitmap(info.optString("portrait"));float side=Math.min(getWidth(),getHeight())*.88f,cx=getWidth()/2f,cy=getHeight()/2f;int save=c.save();if(!faceOnly&&motionEnabled()){float phase=phase();c.rotate((float)Math.sin(phase*2)*3,cx,cy);float scale=1+(float)Math.sin(phase*2)*.035f;c.scale(scale,scale,cx,cy);c.translate(0,(float)Math.sin(phase*2)*side*.015f);}c.drawBitmap(image,null,new RectF(cx-side/2,cy-side/2,cx+side/2,cy+side/2),pen);c.restoreToCount(save);}
 }
